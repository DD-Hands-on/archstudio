{
  "name": "archstudio",
  "version": "2.1.0",
  "private": true,
  "description": "A practice studio for designing system and enterprise architectures.",
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "check": "node build/build.mjs --check",
    "test": "node --test test/*.test.js",
    "e2e": "python3 test/e2e/run_all.py",
    "fingerprint": "python3 test/e2e/fingerprint_check.py",
    "fingerprint:update": "python3 test/e2e/fingerprint_check.py --update"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
