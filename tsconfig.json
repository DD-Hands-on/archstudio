{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/engine/**/*.js"
  ]
}
